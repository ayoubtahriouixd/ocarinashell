#!/usr/bin/env python3
"""ocarina-daily — daily cache for the terminal (phase 8). Python stdlib only.

  ocarina-daily [--force] [--quiet]   writes ~/.cache/ocarinashell/daily.fish (+ ko.txt for fastfetch and daily.json
                                      for the Neovim dashboard) once per day (or with --force)

fish sources it at start-up (no process in the hot path): today's date, your name, the greetings by hour, the proverb
of the day (same pick as Kagi: day of the year % count), 二十四節気 and 七十二候 (same table as the shell), and the
terminal switches from Settei. starship reads the 節気 from $OCARINA_SEKKI.
"""
import json
import os
import pwd
import sys
import tempfile
from datetime import date
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
DATA = REPO / "assets/data"
HOME = Path.home()
CACHE = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "ocarinashell"
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", HOME / ".config")) / "ocarinashell"
OUT = CACHE / "daily.fish"
OUT_JSON = CACHE / "daily.json"


def load(name):
    try:
        return json.loads((DATA / name).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def pick(entries, today):
    """Entry whose start (month, day) is the latest one not after today; early January → last of the year."""
    k = today.month * 100 + today.day
    best = max((e for e in entries if e["start"][0] * 100 + e["start"][1] <= k),
               key=lambda e: e["start"][0] * 100 + e["start"][1], default=None)
    return best or max(entries, key=lambda e: e["start"][0] * 100 + e["start"][1], default={})


def fish_quote(s):
    return "'" + str(s).replace("\\", "\\\\").replace("'", "\\'") + "'"


def display_name():
    try:
        gecos = pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0].strip()
    except KeyError:
        gecos = ""
    name = gecos or os.environ.get("USER", "")
    return name[:1].upper() + name[1:]


def settings():
    try:
        t = json.loads((CONFIG / "settings.json").read_text(encoding="utf-8")).get("terminal", {})
    except (OSError, ValueError, AttributeError):
        t = {}
    return {"greeting": t.get("greeting", True) is not False,
            "fastfetchDaily": t.get("fastfetchDaily", True) is not False}


def main(argv):
    force = "--force" in argv
    quiet = "--quiet" in argv
    today = date.today()
    if not force:
        try:
            if (f"set -g __ocarina_day {today.isoformat()}\n" in OUT.read_text(encoding="utf-8")
                    and OUT_JSON.is_file()):
                return 0
        except OSError:
            pass

    kisetsu = load("kisetsu-72.json")
    sekki = pick(kisetsu.get("sekki", []), today) if kisetsu.get("sekki") else {}
    ko = pick(kisetsu.get("ko", []), today) if kisetsu.get("ko") else {}
    proverbs = load("kotowaza.json").get("kotowaza", [])
    proverb = proverbs[(today.timetuple().tm_yday - 1) % len(proverbs)] if proverbs else {}
    greet = load("kanji-ui.json").get("greetings", {}).get("byHour", [])
    sw = settings()

    # one greeting per hour of the day (0–23), so fish only indexes a list
    by_hour = []
    for h in range(24):
        g = next((g for g in greet if (g["from"] <= h < g["to"]) or (g["from"] > g["to"] and (h >= g["from"] or h < g["to"]))),
                 {"jp": "こんにちは"})
        by_hour.append(g["jp"])

    lines = [
        "# OcarinaShell · GENERATED by ocarina-daily — rewritten every day; do not edit.",
        f"set -g __ocarina_day {today.isoformat()}",
        f"set -g __ocarina_name {fish_quote(display_name())}",
        "set -g __ocarina_greet " + " ".join(fish_quote(g) for g in by_hour),
        f"set -g __ocarina_proverb_jp {fish_quote(proverb.get('jp', ''))}",
        f"set -g __ocarina_proverb_es {fish_quote(proverb.get('es', ''))}",
        f"set -g __ocarina_ko {fish_quote(ko.get('kanji', ''))}",
        f"set -g __ocarina_ko_es {fish_quote(ko.get('es', ''))}",
        f"set -gx OCARINA_SEKKI {fish_quote(sekki.get('kanji', ''))}",
        f"set -g __ocarina_sekki_es {fish_quote(sekki.get('es', ''))}",
        f"set -g __ocarina_greeting_on {1 if sw['greeting'] else 0}",
        f"set -g __ocarina_fastfetch_daily {1 if sw['fastfetchDaily'] else 0}",
    ]
    CACHE.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".daily.", suffix=".fish", dir=CACHE)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, OUT)
    # one line for fastfetch's 季 Kō row (a plain `cat`, no parsing)
    (CACHE / "ko.txt").write_text(f"{ko.get('kanji', '')} · {ko.get('es', '')} ({sekki.get('kanji', '')})\n",
                                  encoding="utf-8")
    # the Neovim dashboard decodes this one (vim.json.decode, no process at start-up)
    data = {"day": today.isoformat(), "proverb": {"jp": proverb.get("jp", ""), "es": proverb.get("es", "")},
            "ko": {"kanji": ko.get("kanji", ""), "es": ko.get("es", "")},
            "sekki": {"kanji": sekki.get("kanji", ""), "es": sekki.get("es", "")}}
    fd, tmp = tempfile.mkstemp(prefix=".daily.", suffix=".json", dir=CACHE)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False)
        f.write("\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, OUT_JSON)
    if not quiet:
        print(f"{OUT}: {sekki.get('kanji', '')} · {ko.get('kanji', '')} · {proverb.get('jp', '')}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
