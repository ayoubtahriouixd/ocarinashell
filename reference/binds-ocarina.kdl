// OcarinaShell — binds adaptados de los de DankMaterialShell de Ayoub (reference/binds-dms-original.kdl).
// BORRADOR de referencia: la fase 1 lo valida con `niri validate`, ajusta los keysyms a la distribución real
// (p. ej. en teclado español `grave` es `masculine`) y lo instala como config/niri/ocarina/binds.kdl.
// Todos los atajos de la shell pasan por el CLI `ocarina`, que tiene respaldo si la shell no responde.

binds {
    // ── OcarinaShell (antes `dms ipc call …`) ─────────────────────────────────────────────
    Ctrl+Alt+Delete hotkey-overlay-title="Monitor del sistema (見張り)" { spawn "ocarina" "tasks"; }
    Ctrl+Shift+R hotkey-overlay-title="Renombrar espacio" { spawn "ocarina" "rename-workspace"; }
    Ctrl+XF86AudioLowerVolume allow-when-locked=true { spawn "ocarina" "media" "down"; }
    Ctrl+XF86AudioRaiseVolume allow-when-locked=true { spawn "ocarina" "media" "up"; }
    Mod+A hotkey-overlay-title="Lanzador (鳥居 Torii)" { spawn "ocarina" "launcher"; }
    Mod+Alt+L hotkey-overlay-title="Bloquear pantalla (鍵)" { spawn "ocarina" "lock"; }
    Mod+Comma hotkey-overlay-title="Ajustes (設定)" { spawn "ocarina" "settings"; }
    Mod+M hotkey-overlay-title="Monitor del sistema (見張り)" { spawn "ocarina" "tasks"; }
    Mod+N hotkey-overlay-title="Bloc de notas (手帳)" { spawn "ocarina" "notes"; }
    Mod+Shift+N hotkey-overlay-title="Centro de notificaciones (文)" { spawn "ocarina" "notifications"; }
    Mod+Shift+W hotkey-overlay-title="Fondos de pantalla (壁紙)" { spawn "ocarina" "wallpaper" "browse"; }
    Mod+Shift+Y hotkey-overlay-title="Crear regla de ventana (窓)" { spawn "ocarina" "rules"; }
    Mod+V hotkey-overlay-title="Portapapeles (蔵)" { spawn "ocarina" "clipboard"; }
    Super+X hotkey-overlay-title="Menú de energía (電源)" { spawn "ocarina" "power"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "ocarina" "audio" "down"; }
    XF86AudioMicMute allow-when-locked=true { spawn "ocarina" "audio" "mic"; }
    XF86AudioMute allow-when-locked=true { spawn "ocarina" "audio" "mute"; }
    XF86AudioNext allow-when-locked=true { spawn "ocarina" "media" "next"; }
    XF86AudioPause allow-when-locked=true { spawn "ocarina" "media" "toggle"; }
    XF86AudioPlay allow-when-locked=true { spawn "ocarina" "media" "toggle"; }
    XF86AudioPrev allow-when-locked=true { spawn "ocarina" "media" "prev"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "ocarina" "audio" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "ocarina" "brightness" "down"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "ocarina" "brightness" "up"; }

    // ── Nuevos de OcarinaShell (no chocan con los tuyos) ──────────────────────────────────
    Mod+Shift+C hotkey-overlay-title="Centro de control (縁側)" { spawn "ocarina" "engawa"; }
    Mod+Alt+S hotkey-overlay-title="忍 Shinobi · ahorro extremo" { spawn "ocarina" "shinobi" "toggle"; }
    Mod+Alt+O hotkey-overlay-title="鬼 Oni · rendimiento extremo" { spawn "ocarina" "oni" "toggle"; }
    Mod+Alt+W hotkey-overlay-title="船 Fune · apps de Windows" { spawn "ocarina" "fune"; }
    Mod+Shift+A hotkey-overlay-title="蛇 Snake · asistente local" { spawn "ocarina" "snake"; }
    Mod+Alt+R hotkey-overlay-title="Grabar pantalla (録)" { spawn "ocarina" "record"; }
    Mod+grave hotkey-overlay-title="Terminal desplegable" { spawn "ocarina" "quickterm"; }
    Print hotkey-overlay-title="Captura de región (撮)" { screenshot; }
    XF86PowerOff { spawn "ocarina" "power"; }              // requiere input { disable-power-key-handling }
    XF86Favorites { spawn "ocarina" "engawa"; }            // tecla ★ del ThinkPad: verificar keysym
    Shift+XF86MonBrightnessDown allow-when-locked=true { spawn "ocarina" "brightness" "down" "--all"; }  // todas las pantallas
    Shift+XF86MonBrightnessUp allow-when-locked=true { spawn "ocarina" "brightness" "up" "--all"; }
    Mod+Alt+P hotkey-overlay-title="色 Cuentagotas" { spawn "ocarina" "pick-color"; }
    Mod+Alt+T hotkey-overlay-title="読 Leer y traducir pantalla" { spawn "ocarina" "read"; }
    // XF86NotificationCenter { spawn "ocarina" "notifications"; }  // verificar si la fila Fn lo emite

    // Chuleta: la de OcarinaShell en tu atajo de siempre; la nativa de niri pasa a Mod+Ctrl+/
    Mod+Shift+Slash hotkey-overlay-title="Chuleta de atajos" { spawn "ocarina" "cheatsheet"; }
    Mod+Ctrl+Slash { show-hotkey-overlay; }

    // ── Espacios de trabajo ───────────────────────────────────────────────────────────────
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+Up { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+I { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+I { move-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }
    Mod+Shift+U { move-workspace-down; }
    Mod+U { focus-workspace-down; }

    // ── Ventanas y columnas ───────────────────────────────────────────────────────────────
    Alt+Print { screenshot-window; }
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Ctrl+End { move-column-to-last; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+K { focus-monitor-up; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Left { focus-monitor-left; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp { move-column-left; }
    Mod+Ctrl+WheelScrollLeft { move-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Down { focus-window-down; }
    Mod+End { focus-column-last; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+F { maximize-column; }
    Mod+H { focus-column-left; }
    Mod+Home { focus-column-first; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Period { expel-window-from-column; }
    Mod+Q repeat=false { close-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Right { focus-column-right; }
    Mod+Shift+Ctrl+Down { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+H { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Left { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Up { move-column-to-monitor-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+S { screenshot-window; }
    Mod+Shift+T { toggle-window-floating; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp { focus-column-left; }
    Mod+Up { focus-window-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollLeft { focus-column-left; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-column-left; }
    Mod+Y { toggle-column-tabbed-display; }
    Mod+P { power-off-monitors; }
    Ctrl+Print { screenshot-screen; }
    Ctrl+XF86Launch1 { screenshot-screen; }
    Mod+S { screenshot; }
    XF86Launch1 { screenshot; }
    Mod+Shift+P { quit; }

    // ── Aplicaciones (alacritty → Ghostty) ────────────────────────────────────────────────
    Mod+B hotkey-overlay-title="Navegador" { spawn "google-chrome-stable"; }
    Mod+E hotkey-overlay-title="Archivos (yazi)" { spawn "ghostty" "+new-window" "-e" "yazi"; }
    Mod+Shift+E hotkey-overlay-title="Archivos (Nautilus)" { spawn "nautilus"; }
    Mod+T hotkey-overlay-title="Terminal" { spawn "ghostty" "+new-window"; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Tab repeat=false { toggle-overview; }
}

// Alt+Tab nativo de niri (el Mod+Tab sigue siendo la vista general, como tenías).
recent-windows {
    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}
