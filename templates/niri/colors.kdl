// OcarinaShell · GENERATED by ocarina-theme from templates/niri/colors.kdl — theme {{kanji}} {{name}}. Do not edit.
// Only colour fields: niri merges them over config/niri/ocarina/appearance.kdl field by field (D-021).
layout {
    focus-ring {
        active-gradient from="{{focusFrom|hex}}" to="{{focusTo|hex}}" angle=135 relative-to="workspace-view" in="oklch shorter hue"
        inactive-color "{{focusInactive|hex}}"
        urgent-color "{{focusUrgent|hex}}"
    }
    shadow {
        color "{{shadow}}"
        inactive-color "{{shadow|fade:0.7}}"
    }
    tab-indicator {
        active-color "{{accent|hex}}"
        inactive-color "{{outlineStrong|hex}}"
        urgent-color "{{accent2|hex}}"
    }
    insert-hint {
        color "{{accent|alpha:0.4}}"
    }
}

recent-windows {
    highlight {
        active-color "{{accent|alpha:0.4}}"
        urgent-color "{{accent2|alpha:0.8}}"
    }
}

overview {
    backdrop-color "{{bg|hex}}"
}

cursor {
    xcursor-theme "{{cursorTheme}}"
}
