// OcarinaShell · GENERATED by ocarina-theme from templates/fastfetch/config.jsonc — theme {{kanji}} {{name}}.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "{{home}}/.local/share/ocarinashell/logo/ocarinashell-mark-512.png",
    // the terminal stretches the picture to exactly width×height cells: keep the mark's 512×321 (1,6:1) proportion
    // with Ghostty's cells (0,6 em × 1,5 em: line height 1,5 like mockup 01) → 24×6; beside the first rows like the
    // mockup
    "width": 21,
    "height": 5,
    "padding": { "top": 2, "left": 0, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "brightColor": false,
    // «26 %» in the text colour, like the mockup
    "percent": { "type": 1, "spaceBeforeUnit": "always" },
    "size": { "ndigits": 1 },
    "freq": { "ndigits": 1 },
    "color": { "keys": "{{accent|ansi}}", "title": "{{accent|ansi}}", "separator": "{{textDim|ansi}}" },
    "key": { "width": 14 }
  },
  "modules": [
    { "type": "title", "color": { "user": "1;{{accent|ansi}}", "at": "90", "host": "1;{{accent|ansi}}" } },
    { "type": "separator", "outputColor": "90", "string": "─", "times": 30 },
    { "type": "os", "key": "{#31}系 {#33}OS{#}" },
    { "type": "kernel", "key": "{#31}核 {#33}Kernel{#}" },
    { "type": "uptime", "key": "{#31}稼 {#33}Uptime{#}", "format": "{?days}{days} d {?}{hours} h {minutes} min" },
    { "type": "packages", "key": "{#31}包 {#33}Paquetes{#}" },
    { "type": "shell", "key": "{#31}殻 {#33}Shell{#}" },
    { "type": "wm", "key": "{#31}窓 {#33}WM{#}" },
    { "type": "custom", "key": "{#31}色 {#33}Tema{#}", "format": "{{kanji}} {{name}} · OcarinaShell" },
    { "type": "command", "key": "{#31}季 {#33}Kō{#}", "shell": "/bin/sh", "text": "cat ~/.cache/ocarinashell/ko.txt 2>/dev/null" },
    { "type": "terminal", "key": "{#31}端 {#33}Terminal{#}", "format": "{pretty-name} {version}" },
    { "type": "cpu", "key": "{#31}脳 {#33}CPU{#}", "format": "{name} ({cores-logical}) @ {freq-max}" },
    { "type": "gpu", "key": "{#31}絵 {#33}GPU{#}", "format": "{name}" },
    { "type": "memory", "key": "{#31}記 {#33}Memoria{#}", "format": "{used} / {total} ({percentage})" },
    { "type": "disk", "key": "{#31}盤 {#33}Disco (/){#}", "folders": "/", "format": "{size-used} / {size-total} · {filesystem}" },
    // in Spanish like the mockup (fastfetch's own status strings are English)
    { "type": "command", "key": "{#31}電 {#33}Batería{#}", "shell": "/bin/sh",
      "text": "for b in /sys/class/power_supply/BAT*; do [ -r \"$b/capacity\" ] || continue; case $(cat \"$b/status\") in Discharging) s=descargando;; Charging) s=cargando;; Full) s=cargada;; *) s=enchufado;; esac; echo \"$(cat \"$b/capacity\") % · $s\"; break; done" },
    { "type": "locale", "key": "{#31}言 {#33}Idioma{#}" },
    "break",
    // two thin strips with a gap, like the mockup (fastfetch's "colors" is one solid block)
    { "type": "custom", "format": "{#30}▅▅▅{#31}▅▅▅{#32}▅▅▅{#33}▅▅▅{#34}▅▅▅{#35}▅▅▅{#36}▅▅▅{#37}▅▅▅{#}" },
    { "type": "custom", "format": "{#90}▅▅▅{#91}▅▅▅{#92}▅▅▅{#93}▅▅▅{#94}▅▅▅{#95}▅▅▅{#96}▅▅▅{#97}▅▅▅{#}" }
  ]
}
