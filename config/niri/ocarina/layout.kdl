// Geometry of the scrolling layout. Colours live in appearance.kdl (and the generated colors.kdl).
layout {
    gaps 12
    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    // Obi (the bar) reserves its own space through the layer-shell exclusive zone.
    struts {
        left 0
        right 0
        top 0
        bottom 0
    }
}
