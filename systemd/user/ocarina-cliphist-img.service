# OcarinaShell · clipboard history (images) for Kura (蔵). docs/01-ARQUITECTURA §2
[Unit]
Description=OcarinaShell · historial del portapapeles (imágenes)
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/wl-paste --type image --watch /usr/bin/cliphist -max-items 500 store
Restart=on-failure
RestartSec=2
Nice=10

[Install]
WantedBy=graphical-session.target
